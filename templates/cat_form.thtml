<form action="{doc_url}/index.php?mode=save_cat" method="POST" id="documents-category-form">
{cid}
    <fieldset class="documents-form-fieldset">
        <legend><b>{cat_informations}</b></legend>

        <div>
            <p><label>{category_label}<span class="documents-required-mark"> *</span></label>
                <input type="text" name="cat_name" value="{category}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>{cat_url_label}<span class="documents-required-mark"> *</span></label>
                <input type="text" name="cat_url" value="{cat_url}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>Meta description (SEO)</label>
                <textarea name="metadescription" id="documents-metadescription" rows="3" maxlength="255" style="width:70%;"></textarea>
                <input type="hidden" name="metadescription_loaded" id="documents-metadescription-loaded" value="0" {xhtml}>
                <br{xhtml}><small>Dedicated search-engine description for this category. Recommended: concise, unique and useful.</small></p>
        </div>
        <div>
            <p><label>{cat_help_label}</label>
                <input type="text" name="cat_help" value="{cat_help}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>{template_label}</label>
                <input type="text" name="template" value="{template}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>{css_label}</label>
                <input type="text" name="css" value="{css}" size="80" maxlength="255" {xhtml}></p>
        </div>
        {map}
        <div>
            <p><label>{custom_header_label}</label>
                <input type="text" name="custom_header" value="{custom_header}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>{custom_footer_label}</label>
                <input type="text" name="custom_footer" value="{custom_footer}" size="80" maxlength="255" {xhtml}></p>
        </div>
        <div>
            <p><label>{catorder_label}</label>
                <input type="text" name="cat_order" value="{cat_order}" size="5" maxlength="5" {xhtml}></p>
            <p>{existing_cat}
            {categories_order}</p>
        </div>

        <div>
            <p><input type="checkbox" name="list_index" value="1" {list_index_ckecked} {xhtml}> {list_index}<br{xhtml}>
               <input type="checkbox" name="submitable" value="1" {submitable_ckecked} {xhtml}> {submitable}</p>
        </div>
        <div id="lang_accessrights">
            <div><p>{lang_owner}: {owner_name}<input type="hidden" name="owner_id" value="{owner_id}"{xhtml}></p></div>
            <div><p>{lang_group}: {group_dropdown}</p></div>
        </div>
        <div id="lang_permissions">
            <p>{lang_perm_key}</p>
            <p>{permissions_editor}</p>
            <p>{lang_permissions_msg}</p>
        </div>

    </fieldset>

    <p class="documents-required-note"><span class="documents-required-mark">*</span><em> {required_field}</em></p>
    {admin_options}
    <input type="submit" name="submit" value="{validate_button}" {xhtml}>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>

</form>
<script type="text/javascript">
(function () {
    var form = document.getElementById('documents-category-form');
    var field = document.getElementById('documents-metadescription');
    var loaded = document.getElementById('documents-metadescription-loaded');
    if (!form || !field || !loaded) {
        return;
    }
    var cid = form.querySelector('input[name="cid"]');
    if (!cid || !cid.value) {
        loaded.value = '1';
        return;
    }
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '{doc_url}/category-meta.php?cid=' + encodeURIComponent(cid.value), true);
    xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) {
            return;
        }
        if (xhr.status === 200) {
            try {
                var response = JSON.parse(xhr.responseText);
                if (response && typeof response.metadescription === 'string') {
                    field.value = response.metadescription;
                    loaded.value = '1';
                }
            } catch (ignore) {}
        }
    };
    xhr.send(null);
}());
</script>