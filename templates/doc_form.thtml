<form action="{doc_url}/index.php?mode=save" method="POST" enctype="multipart/form-data">
{cid}
{doc_url_hidden}
    <div id="documents_edit">
		<fieldset style="margin-top: 10px; width:100%">
			<legend><b>{doc_informations}</b></legend>
				{raws}
				{active}
		</fieldset>
		
		<p><strong><font color="red">*</font><em> {required_field}</em></strong></p>
		{access_perms}
		{admin_options}
		<input type="submit" name="submit" value="{validate_button}" {xhtml}>
		<input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    </div>
</form>