<article id="documents_display" class="documents-document">
    <div class="documents-document__meta">
        {active}
        <span class="documents-document__author">{doc_by} {user_name}</span>
        <span class="documents-document__meta-separator" aria-hidden="true">·</span>
        <span class="documents-document__updated">{modified_label} {modified}</span>
        <span class="documents-document__meta-separator" aria-hidden="true">·</span>
        <span class="documents-document__views">{displayed} {hits} {times}</span>
        {editor}
    </div>

    {main_image}

    {main_content}

    {properties}

    {rich_fields}

    {raws}
</article>

<section id="comments" class="documents-document__comments" aria-label="{comments_title}">
    <h2 class="documents-document__comments-title">{comments_title}</h2>
    <div id="commentbar">{commentbar}</div>
</section>
