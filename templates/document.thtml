<article id="documents_display" class="documents-document">
    <p class="documents-document__meta">{active}{doc_by} {user_name} · {displayed} {hits} {times} {editor}</p>

    <div class="documents-document__content">
        {raws}
    </div>

    <footer class="documents-document__footer">
        <a href="{document_url}">{document_url}</a>
    </footer>
</article>

<section id="comments" class="documents-document__comments" aria-label="Comments">
    <div id="commentbar">{commentbar}</div>
</section>
